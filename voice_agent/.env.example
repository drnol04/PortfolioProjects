# ============================================================
# VOICE AGENT - Variables de Entorno
# Copia este archivo como .env y rellena tus claves
# ============================================================

# Claude / Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (para clonar tu voz)
ELEVENLABS_API_KEY=...
# El Voice ID se obtiene después de clonar tu voz en elevenlabs.io
ELEVENLABS_VOICE_ID=...

# Opcional: directorio de documentos personalizado
DOCUMENTS_DIR=./documents
